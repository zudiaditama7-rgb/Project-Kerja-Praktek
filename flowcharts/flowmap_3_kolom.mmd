flowchart LR
    %% Pengaturan Style Hitam Putih (Sesuai Referensi Gambar Anda)
    classDef process fill:#fff,stroke:#000,stroke-width:1px,color:#000;
    classDef decision fill:#fff,stroke:#000,stroke-width:1px,color:#000;
    classDef startend fill:#fff,stroke:#000,stroke-width:2px,color:#000;
    classDef database fill:#fff,stroke:#000,stroke-width:1px,color:#000;

    %% Trik agar kolom berjajar lurus dari kiri ke kanan
    A_Start ~~~ B_Start
    B_Start ~~~ C_Start

    %% KOLOM 1
    subgraph Kiri ["WALI KELAS / GURU"]
        direction TB
        A_Start((Mulai)):::startend --> Login[Dasbor Sistem\nPresensi]:::process
        Login --> CekHadir{Bisa Mengajar\nHari Ini?}:::decision
        
        CekHadir -->|Tidak| Ajukan[Ajukan Guru\nPengganti]:::process
        CekHadir -->|Ya| Input[Lakukan Presensi\nSiswa]:::process
        
        BuatRekap[Klik Ajukan\nRekap Laporan]:::process
    end

    %% KOLOM 2
    subgraph Tengah ["ADMIN & SISTEM APLIKASI"]
        direction TB
        B_Start[Admin Setujui &\nBeri Tugas]:::process
        GPInput[Guru Pengganti\nInput Kehadiran]:::process
        
        DB[(Sistem Simpan\nKe Database)]:::database
        
        ProsesRekap[Sistem Memvalidasi\nData Kehadiran]:::process
        
        B_Start --> GPInput
        GPInput --> DB
    end

    %% KOLOM 3
    subgraph Kanan ["KEPALA SEKOLAH"]
        direction TB
        C_Start[Notifikasi\nLaporan Masuk]:::process
        CekRekap{Laporan Sesuai\n& Disetujui?}:::decision
        Cetak[Generate Dokumen\nPDF Resmi]:::process
        End((Selesai)):::startend
        
        C_Start --> CekRekap
        CekRekap -->|Ya| Cetak
        Cetak --> End
    end

    %% GARIS PENGHUBUNG LINTAS KOLOM
    %% Menggunakan garis putus-putus agar layout kolom tidak rusak
    Ajukan -.-> B_Start
    Input -.-> DB
    
    DB -.-> BuatRekap
    BuatRekap -.-> ProsesRekap
    ProsesRekap -.-> C_Start
    
    CekRekap -.->|Tidak| ProsesRekap
