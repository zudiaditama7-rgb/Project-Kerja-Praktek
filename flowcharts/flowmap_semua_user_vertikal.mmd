flowchart TD
    %% Menggunakan flowchart TD (Top-Down / Vertikal)
    classDef process fill:#fff,stroke:#000,stroke-width:1px,color:#000;
    classDef decision fill:#fff,stroke:#000,stroke-width:1px,color:#000;
    classDef startend fill:#fff,stroke:#000,stroke-width:2px,color:#000;
    classDef database fill:#fff,stroke:#000,stroke-width:1px,color:#000;

    %% Memaksa semua kolom sejajar menyamping (sehingga bentuknya jadi kolom vertikal)
    A_Start ~~~ W_Start
    W_Start ~~~ M_Start
    M_Start ~~~ P_Start
    P_Start ~~~ K_Start
    K_Start ~~~ S_Start

    %% 1. ADMIN
    subgraph ADMIN ["ADMIN"]
        A_Start([Mulai]):::startend --> A1[Kelola Data Master]:::process
        A2[Evaluasi Pengajuan]:::process --> A3{Disetujui?}:::decision
        A3 -->|Ya| A4[Assign Pengganti]:::process
        A3 -->|Tidak| A2
    end

    %% 2. WALI KELAS
    subgraph WALI_KELAS ["WALI KELAS"]
        W_Start([Dasbor Wali]):::startend --> W1{Pilih Menu}:::decision
        W1 -->|Menu Presensi| W2[/Input Presensi Harian/]:::process
        W1 -->|Berhalangan| W3[/Ajukan Pengganti/]:::process
        W1 -->|Menu Laporan| W4[/Ajukan Rekap/]:::process
        W5[/Download PDF/]:::process
    end

    %% 3. GURU MAPEL
    subgraph GURU_MAPEL ["GURU MAPEL"]
        M_Start([Dasbor Mapel]):::startend --> M1[Pilih Kelas]:::process
        M1 --> M2[/Input Presensi Mapel/]:::process
    end

    %% 4. GURU PENGGANTI
    subgraph GURU_PENGGANTI ["GURU PENGGANTI"]
        P_Start([Dasbor Pengganti]):::startend --> P1[Terima Tugas]:::process
        P1 --> P2[/Input Presensi Kelas/]:::process
    end

    %% 5. KEPALA SEKOLAH
    subgraph KEPALA_SEKOLAH ["KEPALA SEKOLAH"]
        K_Start([Dasbor Kepsek]):::startend --> K1[Monitoring Data]:::process
        K2[Evaluasi Rekap]:::process --> K3{Setuju?}:::decision
        K3 -->|Ya| K4[Approve Laporan]:::process
        K3 -->|Tidak| K2
    end

    %% 6. SISTEM & DATABASE
    subgraph SISTEM_DATABASE ["SISTEM & DATABASE"]
        S_Start[(Database Master)]:::database
        S1[(DB Presensi)]:::database
        S2[(DB Laporan)]:::database
        S3[Proses Cetak PDF]:::process
        S_End([Selesai]):::startend
    end

    %% ========================================
    %% KONEKSI LINTAS KOLOM (Dibuat putus-putus)
    %% ========================================
    
    A1 -.->|Sinkronisasi| W_Start
    A1 -.->|Sinkronisasi| M_Start
    A1 -.-> S_Start
    
    W2 -.->|Simpan| S1
    M2 -.->|Simpan| S1
    P2 -.->|Simpan| S1
    
    S1 -.->|Tarik Data| K1
    
    W3 -.->|Notifikasi| A2
    A4 -.->|Tugas Baru| P1
    
    W4 -.->|Kirim| S2
    S2 -.->|Validasi| K2
    K4 -.->|Acc| S3
    S3 -.->|Dokumen Siap| W5
    
    W5 -.-> S_End
