erDiagram
    USERS ||--o{ PRESENSIS : mencatat
    USERS ||--o{ PENGAJUAN_PRESENSIS : mengajukan
    USERS ||--o{ KELAS : wali_kelas
    USERS ||--o{ TUGAS_PENGGANTIS : wali
    USERS ||--o{ TUGAS_PENGGANTIS : guru
    SISWAS ||--o{ PRESENSIS : memiliki
    SISWAS ||--o{ ROMBELS : terdaftar
    SISWAS ||--o{ RIWAYAT_SISWAS : riwayat
    KELAS ||--o{ ROMBELS : berisi

    USERS {
        int id PK
        string name
        string username
        string password
        string role
        string avatar
    }
    SISWAS {
        int id PK
        string nis
        string nama_siswa
        string status
    }
    KELAS {
        int id PK
        string nama_kelas
        int wali_kelas_id FK
        string semester
    }
    ROMBELS {
        int id PK
        int siswa_id FK
        int kelas_id FK
        string semester
    }
    PRESENSIS {
        int id PK
        int siswa_id FK
        int user_id FK
        date tanggal
        string status
        string nama_pengganti
        string nama_mapel
        string document_path
    }
    PENGAJUAN_PRESENSIS {
        int id PK
        int user_id FK
        string kelas
        string tipe
        string bulan
        string tahun
        string status
        int acc_by FK
        date acc_date
    }
    TUGAS_PENGGANTIS {
        int id PK
        int wali_kelas_id FK
        int guru_pengganti_id FK
        string kelas
        date tanggal
        string alasan
        string status
        string document_path
        string keterangan_ditolak
    }
    RIWAYAT_SISWAS {
        int id PK
        int siswa_id FK
        string tahun_ajaran
        string kelas_asal
        string kelas_tujuan
        string status
    }
    TAHUN_AJARANS {
        int id PK
        string nama_tahun
        boolean is_active
        date tanggal_mulai_gasal
        date tanggal_selesai_gasal
        date tanggal_mulai_genap
        date tanggal_selesai_genap
    }
