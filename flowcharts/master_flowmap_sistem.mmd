flowchart TD
    %% Konfigurasi style
    classDef process fill:#e2e8f0,stroke:#333,stroke-width:1px;
    classDef doc fill:#fff,stroke:#333,stroke-width:1px;
    classDef db fill:#059669,stroke:#333,stroke-width:1px,color:#fff;
    classDef decision fill:#fde047,stroke:#333,stroke-width:1px;
    classDef startend fill:#1e293b,stroke:#fff,stroke-width:2px,color:#fff;

    %% Trik untuk memaksa Mermaid menyejajarkan kolom (swimlane) secara horizontal
    A_Start ~~~ W_Start
    W_Start ~~~ GM_Start
    GM_Start ~~~ GP_Start
    GP_Start ~~~ KS_Start

    subgraph Admin ["ADMIN"]
        direction TB
        A_Start([Mulai Set Data]):::startend
        A1[Kelola Data Master:\nSiswa, Kelas, TA]:::process
        A2[Evaluasi Pengajuan\nGuru Pengganti]:::process
        A3{Setuju?}:::decision
        A4[Assign Guru Pengganti]:::process

        A_Start --> A1
        A2 --> A3
        A3 -->|Ya| A4
        A3 -->|Tidak| A2
    end

    subgraph Wali_Kelas ["WALI KELAS"]
        direction TB
        W_Start([Akses Dashboard]):::startend
        W1[Buka Kelas Aktif]:::process
        W2[/Input Presensi Harian/]:::doc
        W3[/Ajukan Guru Pengganti/]:::doc
        W4[/Ajukan Rekap Laporan/]:::doc
        W5[/Download PDF Rekap/]:::doc

        W_Start --> W1
        W1 --> W2
        W1 --> W3
        W1 --> W4
        W4 --> W5
    end

    subgraph Guru_Mapel ["GURU MAPEL"]
        direction TB
        GM_Start([Akses Mapel]):::startend
        GM1[Pilih Kelas & Mapel]:::process
        GM2[/Input Presensi Mapel/]:::doc

        GM_Start --> GM1
        GM1 --> GM2
    end

    subgraph Guru_Pengganti ["GURU PENGGANTI"]
        direction TB
        GP_Start([Cek Tugas]):::startend
        GP1[Terima Tugas Kelas]:::process
        GP2[/Input Presensi Pengganti/]:::doc

        GP_Start --> GP1
        GP1 --> GP2
    end

    subgraph Kepala_Sekolah ["KEPALA SEKOLAH"]
        direction TB
        KS_Start([Monitoring]):::startend
        KS1[Evaluasi Pengajuan Rekap]:::process
        KS2{Setuju?}:::decision
        KS3[Approve Rekap]:::process
        KS4[Lihat Laporan Global]:::process

        KS_Start --> KS1
        KS1 --> KS2
        KS2 -->|Ya| KS3
        KS2 -->|Tidak| KS1
    end

    %% Garis Penghubung Lintas Aktor (Cross-Lane)
    %% Menggunakan garis putus-putus atau panah agar tidak merusak layout utama vertikal
    A1 -.->|Sinkronisasi Data| W1
    A1 -.->|Sinkronisasi Data| GM1
    
    W3 -->|Kirim Pengajuan| A2
    A4 -->|Tugas Baru| GP1
    
    W4 -->|Kirim Pengajuan| KS1
    KS3 -.->|Generate PDF| W5
    
    W2 -.->|Data Masuk| KS4
    GM2 -.->|Data Masuk| KS4
    GP2 -.->|Data Masuk| KS4
